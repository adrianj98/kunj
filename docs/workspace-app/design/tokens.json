{
  "$schema": "kunj-workspace design tokens v1",
  "fonts": {
    "sans": "Inter, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "body": "13px / 1.55",
    "small": "12px",
    "caption": "11px",
    "mono-terminal": "12.5px / 1.6",
    "mono-diff": "11.5px / 1.65",
    "title": "14px / 600",
    "letter-spacing": "-0.005em"
  },
  "radius": {"control": "5px", "card": "6px", "window": "12px"},
  "spacing": [2, 4, 6, 8, 10, 12, 16, 20, 24],
  "layout": {
    "sidebar-width": 272,
    "header-height": 52,
    "tabbar-height": 40,
    "statusbar-height": 28,
    "sidebar-row-padding": "9px 10px",
    "pane-split": "11fr 9fr",
    "changes-file-list-width": 196
  },
  "themes": {
    "warm": {
      "bg": "#1a1816", "side": "#201d1b", "raised": "#2b2724", "raised2": "#201d1b",
      "border": "#2d2926", "borderStrong": "#3a3531",
      "text": "#f1ede6", "text2": "#dad2c1", "muted": "#8f877c", "faint": "#6b6459", "faintest": "#5c554d", "idle": "#4a443f",
      "amber": "#e8a33d", "green": "#5ec26a", "red": "#e06c5f", "addBg": "#1f2a21", "link": "#e9c47a",
      "primaryBg": "#f1ede6", "primaryFg": "#1a1816", "primaryHint": "#6b6459",
      "term": "#151312", "termText": "#dad2c1", "termMuted": "#8a8178", "termAccent": "#7ec8ff"
    },
    "light": {
      "bg": "#ffffff", "side": "#f3f1ee", "raised": "#e8e4de", "raised2": "#f7f5f2",
      "border": "#e4e0da", "borderStrong": "#cfc9c0",
      "text": "#1d1a17", "text2": "#3d3833", "muted": "#6f675d", "faint": "#8d8478", "faintest": "#aaa298", "idle": "#cfc8bf",
      "amber": "#b8730f", "green": "#2e8b45", "red": "#c0392b", "addBg": "#e9f5ec", "link": "#8a5a0c",
      "primaryBg": "#1d1a17", "primaryFg": "#ffffff", "primaryHint": "#a39d95",
      "term": "#faf9f7", "termText": "#2b2622", "termMuted": "#8d8478", "termAccent": "#0a63c9"
    },
    "graphite": {
      "bg": "#141518", "side": "#191b1f", "raised": "#24272d", "raised2": "#1b1d22",
      "border": "#262930", "borderStrong": "#33373f",
      "text": "#eceef2", "text2": "#c6cad2", "muted": "#8a8f99", "faint": "#656a74", "faintest": "#4e525a", "idle": "#3a3e46",
      "amber": "#e5a63a", "green": "#4cc38a", "red": "#e5534b", "addBg": "#17241d", "link": "#8da2ff",
      "primaryBg": "#5e6ad2", "primaryFg": "#ffffff", "primaryHint": "#c7cbf5",
      "term": "#0f1012", "termText": "#c6cad2", "termMuted": "#7c818b", "termAccent": "#8da2ff"
    }
  },
  "semantics": {
    "bg": "window / content background",
    "side": "sidebar (navigation layer) background",
    "raised": "selected row, active tab, selected file",
    "raised2": "inputs, hunk headers, select backgrounds",
    "border": "hairline dividers (1px)",
    "borderStrong": "control borders, selected-row border",
    "text / text2 / muted / faint / faintest": "five-step text ramp, primary to decorative",
    "idle": "status dot: no agent / stopped",
    "green": "status dot: agent running; diff additions",
    "amber": "status dot: agent waiting for input; diff modified",
    "red": "diff deletions, errors",
    "addBg": "diff added-line background",
    "primaryBg / primaryFg": "the single tinted action (Create PR); nothing else is tinted",
    "term*": "xterm.js theme: background, foreground, brightBlack, blue"
  }
}
