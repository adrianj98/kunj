#!/bin/sh
# Git credential helper for kunj containers. Answers only for origin's host
# ($KUNJ_CREDENTIAL_HOST), so a token forwarded for GitHub is never sent to
# any other host a repository or the agent points git at.

[ "${1:-}" = "get" ] || exit 0   # store / erase: nothing is stored

host=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in
    host=*) host=${line#host=} ;;
  esac
done

[ -n "${KUNJ_CREDENTIAL_HOST:-}" ] && [ "$host" = "$KUNJ_CREDENTIAL_HOST" ] || exit 0

if [ -n "${GH_TOKEN:-}" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$GH_TOKEN"
elif [ -n "${GITHUB_TOKEN:-}" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
elif [ -n "${GITLAB_TOKEN:-}" ]; then
  printf 'username=oauth2\npassword=%s\n' "$GITLAB_TOKEN"
fi
exit 0
